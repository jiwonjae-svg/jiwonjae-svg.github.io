    title: string;
    colorCount: string;
    colorCountDesc: string;
    particleSize: string;
    particleSizeDesc: string;
    particleDensity: string;
    particleDensityDesc: string;
    blur: string;
    blurDesc: string;
    reset: string;
  };
  actions: {
    convert: string;
    converting: string;
