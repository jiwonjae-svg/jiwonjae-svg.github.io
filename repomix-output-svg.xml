<file path="src/App.css">
/* 앱 레이아웃 */
.app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-primary);
}

.main {
  flex: 1;
  padding: 2rem 1.5rem;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

/* 히어로 섹션 */
.hero {
  text-align: center;
  margin-bottom: 2rem;
}

.hero-title {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--text-primary);
  margin: 0 0 0.5rem;
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.hero-description {
  font-size: 1.125rem;
  color: var(--text-secondary);
  margin: 0;
  max-width: 600px;
  margin: 0 auto;
}

/* 섹션 스타일 */
.upload-section {
  margin-bottom: 2rem;
}

.settings-section {
  margin-bottom: 2rem;
}

.convert-section {
  display: flex;
  justify-content: center;
  margin-bottom: 2rem;
}

.btn-convert {
  min-width: 200px;
  gap: 0.5rem;
}

.btn-badge {
  background: white;
  color: var(--primary-color);
  font-size: 0.75rem;
  font-weight: 700;
  padding: 0.125rem 0.5rem;
  border-radius: 1rem;
  margin-left: 0.25rem;
}

/* Google AdSense 광고 컨테이너 */
.ad-container {
  width: 100%;
  margin: 2rem 0;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 90px;
}

.ad-container ins {
  width: 100%;
  max-width: 100%;
}

/* 스피너 */
.spinner-white {
  width: 18px;
  height: 18px;
  border: 2px solid white;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 반응형 */
@media (max-width: 768px) {
  .hero-title {
    font-size: 2rem;
  }

  .hero-description {
    font-size: 1rem;
  }
}

@media (max-width: 640px) {
  .main {
    padding: 1.5rem 1rem;
  }

  .hero-title {
    font-size: 1.75rem;
  }

  .hero-description {
    font-size: 0.875rem;
  }

  .btn-convert {
    width: 100%;
  }
}
</file>

